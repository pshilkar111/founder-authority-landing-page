{
  "entities": {
    "linkedin_audit_leads": {
      "title": "LinkedIn Audit Leads",
      "description": "Captured founder leads and their generated LinkedIn Authority Score report details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Founder's full name"
        },
        "email": {
          "type": "string",
          "description": "Founder's business email"
        },
        "company": {
          "type": "string",
          "description": "Founder's company or venture name"
        },
        "linkedin_url": {
          "type": "string",
          "description": "Target LinkedIn profile URL"
        },
        "authority_score": {
          "type": "number",
          "description": "Computed overall LinkedIn Authority Score (0-10)"
        },
        "breakdown": {
          "type": "object",
          "description": "Scores across the 5 core framework categories"
        },
        "strengths": {
          "type": "array",
          "description": "Key profile strengths"
        },
        "improvements": {
          "type": "array",
          "description": "Key areas for authority improvement"
        },
        "recommended_headline": {
          "type": "string",
          "description": "AI-optimized recommended headline"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp when the audit lead was submitted"
        }
      },
      "required": ["name", "email", "linkedin_url", "authority_score", "timestamp"]
    },
    "strategy_call_bookings": {
      "title": "Strategy Call Bookings",
      "description": "Booked strategy calls with founders saved to Firestore",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Founder's full name"
        },
        "fullName": {
          "type": "string",
          "description": "Founder's full name"
        },
        "email": {
          "type": "string",
          "description": "Founder's work email"
        },
        "company": {
          "type": "string",
          "description": "Company or venture name"
        },
        "companyName": {
          "type": "string",
          "description": "Company or venture name"
        },
        "linkedinUrl": {
          "type": "string",
          "description": "Founder's LinkedIn URL"
        },
        "dateSelected": {
          "type": "string",
          "description": "Date selected by the founder"
        },
        "timeSelected": {
          "type": "string",
          "description": "Time selected by the founder"
        },
        "primaryGoal": {
          "type": "string",
          "description": "Founder's primary growth goal"
        },
        "selectedPlan": {
          "type": "string",
          "description": "Plan selected or discussed"
        },
        "status": {
          "type": "string",
          "description": "Booking status (e.g. confirmed)"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the booking was stored"
        }
      },
      "required": ["email", "dateSelected", "timeSelected"]
    },
    "admin_users": {
      "title": "Admin Users",
      "description": "List of authorized administrator emails and roles",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin user email"
        },
        "role": {
          "type": "string",
          "description": "Administrator role (e.g. superadmin, admin)"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin access was granted"
        }
      },
      "required": ["email", "role"]
    }
  }
}
