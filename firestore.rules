rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Audit Leads collection:
    // Allow public write (create) for inbound prospective founders submitting their audit lead
    // Allow read/update/delete for authenticated admin users only
    match /linkedin_audit_leads/{leadId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.email is string &&
                       request.resource.data.linkedin_url is string;
      allow read, update, delete: if request.auth != null;
    }

    // Strategy Call Bookings collection:
    // Allow public write (create) for prospective founders booking a 20-min strategy call
    // Allow read/update/delete for authenticated admin users only
    match /strategy_call_bookings/{bookingId} {
      allow create: if ((request.resource.data.fullName is string) || (request.resource.data.name is string)) &&
                       request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }

    // Admin Users collection:
    match /admin_users/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
